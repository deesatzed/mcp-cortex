{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mcp-cortex/context_cell.schema.json",
  "title": "ContextCell",
  "type": "object",
  "required": ["id", "schema", "summary", "labels", "provenance", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^ctx://" },
    "schema": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provenance": {
      "type": "object",
      "required": ["source", "timestamp"],
      "properties": {
        "source": { "type": "string" },
        "timestamp": { "type": "string" },
        "actor": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "version": { "type": "integer", "minimum": 1 },
    "payload": { "type": ["object", "null"] },
    "payload_ref": { "type": ["string", "null"] },
    "links": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ttl_seconds": { "type": ["integer", "null"], "minimum": 1 },
    "trust_level": { "enum": ["trusted", "verified", "untrusted", "hostile"] }
  },
  "additionalProperties": false
}
